# Zorunlu
DISCORD_TOKEN=
# Whitelist'i yönetebilecek kullanıcı ID'leri (virgülle). Sunucu sahibi her zaman dahildir.
MASTER_ADMINS=
# Entegrasyon var mı diye deneme ekledim
# İsteğe bağlı
# Komutları tek sunucuya anında kaydetmek için (boşsa global kayıt, yayılması ~1 saat sürebilir)
GUILD_ID=
# Devre kesici: pencere (dk) içinde limitten FAZLA silme (kanal/rol/webhook/emoji) -> ban
BREAKER_LIMIT=10
# Aynı pencerede limitten FAZLA ban/kick -> ban
BREAKER_MEMBER_LIMIT=20
BREAKER_WINDOW_MINUTES=10
# İhlal / devre kesici anında sunucuyu otomatik kilitle
AUTO_LOCKDOWN=false
# Ayarlanırsa lockdown onayında şifre modalı açılır
LOCKDOWN_PASSWORD=
# Raid koruması, yönetici DM'leri ve rol üyeliği yedeği "Server Members Intent" gerektirir.
# Developer Portal'da açmadıysanız false yapın (bu özellikler devre dışı kalır).
MEMBERS_INTENT=true
DATA_FILE=data/sentinel.db
